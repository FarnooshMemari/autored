# Append these to a fresh `cp .env.example .env` in the LibreChat clone (secrets are generated locally).
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
CHECK_BALANCE=false
BAN_VIOLATIONS=false
LOGIN_MAX=2000          # raised: one assessment performs many synthetic logins (default 7 blocks it)
REGISTER_MAX=2000
LIMIT_LOGIN_IP=false
LIMIT_LOGIN_USER=false
# Generate: JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY, CREDS_IV, MEILI_MASTER_KEY
