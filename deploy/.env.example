# Copy to deploy/.env and fill in. NEVER commit the real .env.
# A public-facing instance MUST set a strong token.

# Required in public mode: bearer token the frontend must send.
AUTORED_API_TOKEN=generate-a-long-random-string

# Grants admin-approved authorization for onboarded targets (sandbox verification).
AUTORED_ADMIN_TOKEN=another-long-random-string

# Comma-separated origins allowed to call the API from a browser (CORS).
# Include your public site so "Run live assessment" can reach the backend.
AUTORED_CORS_ORIGINS=https://farnooshmemari.github.io,http://localhost:5173

# Sandbox lock: onboarding accepts ONLY these origins (the bundled demo target).
# Leave as-is for the safe public demo. Empty = allow any SSRF-valid public URL
# (only do this on a self-hosted instance you control, for targets you authorize).
AUTORED_DEMO_TARGET_ORIGINS=http://127.0.0.1:8100
